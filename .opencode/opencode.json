{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_URL": "http://127.0.0.1:3002"
      }
    },
    "semgrep": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semgrep==1.172.0",
        "semgrep",
        "mcp"
      ],
      "enabled": true
    }
  }
}